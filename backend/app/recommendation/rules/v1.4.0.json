{
  "version": "1.4.0",
  "released": "2026-10-26",
  "description": "Mean-variance allocation using historical return estimates and Ledoit-Wolf covariance, with historical volatility and drawdown shown for context.",
  "groups": [
    "equity",
    "fixed_income",
    "gold",
    "cash"
  ],
  "min_age_years": 3,
